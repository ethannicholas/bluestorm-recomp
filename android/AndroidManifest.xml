<?xml version="1.0" encoding="utf-8"?>
<!-- Immersive OpenXR app. There is no Java source: the framework's
     android.app.NativeActivity loads libwaverace.so and calls android_main().

     There is also no manifest merger here (no Gradle), so the OpenXR loader's own
     manifest requirements - the two permissions and the <queries> block it uses to
     reach the runtime broker - are written out below by hand. Without the <queries>
     entries the loader cannot see the runtime on Android 11+ and xrCreateInstance
     fails. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.example.waverace"
          android:versionCode="2"
          android:versionName="0.2">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />

    <!-- Immersive VR, not a 2D panel: this is what makes the app take over the display
         and own the controllers rather than running in the home environment. -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />

    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent><action android:name="org.khronos.openxr.OpenXRRuntimeService" /></intent>
        <intent><action android:name="org.khronos.openxr.OpenXRApiLayerService" /></intent>
    </queries>

    <application android:label="Wave Race"
                 android:hasCode="false"
                 android:debuggable="true"
                 android:extractNativeLibs="true">

        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3" />

        <activity android:name="android.app.NativeActivity"
                  android:label="Wave Race"
                  android:exported="true"
                  android:launchMode="singleTask"
                  android:screenOrientation="landscape"
                  android:excludeFromRecents="false"
                  android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="waverace" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Launches straight into the immersive runtime on Horizon OS. -->
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>
    </application>
</manifest>
